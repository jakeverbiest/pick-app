rules_version = '2';

// PICK Firestore Security Rules
//
// ⚠️ DEPLOYMENT DEPENDENCY: the app currently signs in via simpleAuthService
// (local AsyncStorage), NOT Firebase Auth — so request.auth is null on every
// request and the PRODUCTION rules below would block the app entirely.
//
// Path to production:
//   1. Switch the app to Firebase Auth (authService.ts already exists)
//   2. Deploy these rules:  firebase deploy --only firestore:rules
//
// Until then the project is in test mode (open). Do not ship to app stores
// in test mode — anyone with the API key can read/write everything.
//
// Deploy: firebase deploy --only firestore:rules  (from repo root, needs firebase.json)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // --- Cleanups: OWNER-ONLY reads (routes reveal home locations even
    //     trimmed; the shared community map uses segment_status, which has
    //     no routes). Team leaderboards will need a Cloud Function aggregate
    //     before they work cross-user again — acceptable until then. ---
    match /cleanups/{cleanupId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.items_count is number
        && request.resource.data.items_count >= 0
        && request.resource.data.items_count < 5000
        && request.resource.data.weight_lb is number
        && request.resource.data.weight_lb >= 0
        && request.resource.data.weight_lb < 1000;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // --- User settings: private to the owner ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- Team stats: the privacy-safe leaderboard aggregate. Written only by
    //     the onCleanupWrite / rebuildTeamStats Cloud Functions (the admin SDK
    //     bypasses these rules); any signed-in user may read. No raw cleanup
    //     routes are ever exposed here. ---
    match /team_stats/{teamId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // --- Teams directory: shared list of named teams. Any signed-in user reads
    //     (directory + existence checks) and may create a team stamped with
    //     their own uid; only the creator may change or remove it. ---
    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.created_by)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 60;
      allow update, delete: if isOwner(resource.data.created_by);
    }

    // --- Badges: readable by all signed-in (profiles), writable by owner ---
    match /badges/{badgeId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // --- User stats: the per-user public leaderboard aggregate. Totals +
    //     display name + team only — NEVER routes. Any signed-in user reads
    //     (to render the individual leaderboard); each user writes only their
    //     own doc. Opt-out is the `hidden` flag, filtered client-side. ---
    match /user_stats/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId);
    }

    // --- Community posts: a cleanup photo + caption (no precise location).
    //     Any signed-in user reads; the author creates/deletes their own;
    //     anyone signed-in may toggle a like (only the liked_by array changes). ---
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.uid);
      allow delete: if isOwner(resource.data.uid);
      allow update: if signedIn() && (
        isOwner(resource.data.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liked_by'])
      );
    }

    // --- Challenges: shared. Anyone signed-in reads; creator manages;
    //     participants may add themselves ---
    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.created_by);
      allow update: if signedIn() && (
        resource.data.created_by == request.auth.uid
        // joining: only the participants array may change
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['participants', 'updated_at'])
      );
      allow delete: if signedIn() && resource.data.created_by == request.auth.uid;
    }

    // --- Street segment status: the shared coverage layer.
    //     Anyone signed-in can read and stamp segments cleaned, but only
    //     with a plausible payload (no backdating, no spoofing others) ---
    match /segment_status/{segmentId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.last_user == request.auth.uid
        && request.resource.data.last_cleaned is number
        && request.resource.data.last_cleaned <= request.time.toMillis() + 60000
        && request.resource.data.last_cleaned > request.time.toMillis() - 86400000;
    }

    // --- Park status: same shared coverage model as segments, for park zones ---
    match /park_status/{parkId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.last_user == request.auth.uid
        && request.resource.data.last_cleaned is number
        && request.resource.data.last_cleaned <= request.time.toMillis() + 60000
        && request.resource.data.last_cleaned > request.time.toMillis() - 86400000;
    }

    // --- Analytics: write-only from clients ---
    match /analytics/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // --- Feedback: testers submit; only the owner (you) reads via console/admin ---
    match /feedback/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // Everything else: denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
