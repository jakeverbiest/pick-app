rules_version = '2';

// PICK Firestore Security Rules
//
// STATUS: LIVE. Published to project pick-app-74c2e. The app authenticates
// with Firebase Auth (src/services/authService.ts) and writes every document
// keyed to the Firebase Auth UID, so these owner-scoped rules are satisfied.
//
// This file is the version-controlled source of truth. To redeploy after edits:
//   firebase deploy --only firestore:rules        (needs firebase.json + login)
//
// Design notes:
// - Cleanups are OWNER-ONLY reads: routes can reveal home locations even when
//   trimmed. The shared community map reads segment_status (no routes).
// - Leaderboards read team_stats, which is written ONLY by the Cloud Functions
//   (admin SDK bypasses these rules); clients can read but never write it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // --- Cleanups: OWNER-ONLY reads (routes reveal home locations even
    //     trimmed; the shared community map uses segment_status, which has
    //     no routes). Team leaderboards are served by team_stats, populated
    //     by the Cloud Functions below. ---
    match /cleanups/{cleanupId} {
      allow read: if isOwner(resource.data.userId);
      // weight_lb is OPTIONAL — the app doesn't send it (bags, not pounds, are
      // the unit). Requiring it silently rejected every real cleanup, forcing a
      // local-only fallback. Validate it only when present.
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.items_count is number
        && request.resource.data.items_count >= 0
        && request.resource.data.items_count < 5000
        && (!('weight_lb' in request.resource.data) || (
              request.resource.data.weight_lb is number
              && request.resource.data.weight_lb >= 0
              && request.resource.data.weight_lb < 1000));
      allow update, delete: if isOwner(resource.data.userId);
    }

    // --- User settings: private to the owner ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- Teams: the shared team directory. Anyone signed-in can browse and
    //     create a team (to join or start one); team docs are immutable once
    //     created. Membership itself lives in each user's private settings;
    //     member/activity counts come from team_stats (Cloud Function).
    //
    //     Sponsor/civic-org teams additionally carry `area` and `goal`
    //     (CIVIC_ORG_DASHBOARD_SPEC.md) — set only via the createSponsorTeam
    //     Cloud Function (Admin SDK, bypasses this rule entirely), never by a
    //     direct client write. This rule doesn't need to change for that: it
    //     never restricted extra fields on create, and update/delete already
    //     stay `if false` either way, so a sponsor team is exactly as
    //     immutable post-creation as a casual one. ---
    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      allow update, delete: if false;
    }

    // --- Team tokens: sponsor-dashboard access tokens for the civic-org
    //     impact dashboard (CIVIC_ORG_DASHBOARD_SPEC.md). Forward map
    //     (team_tokens, teamId -> token) and reverse index (team_token_index,
    //     token -> teamId), mirroring the email_index pattern below —
    //     "someone who already knows one side can look the other up,
    //     nobody can browse the collection." Written only by
    //     createSponsorTeam (Admin SDK); read only via the getTeamToken
    //     callable (creator-only) and the orgDashboard HTTPS endpoint —
    //     both also Admin SDK, so clients never read these directly. ---
    match /team_tokens/{teamId} {
      allow read, write: if false;
    }
    match /team_token_index/{token} {
      allow read, write: if false;
    }

    // --- Team snapshots: weekly district-totals history for the civic-org
    //     dashboard's time-series view. Written only by
    //     scheduledOrgSnapshots (Admin SDK); read only via the orgDashboard
    //     HTTPS endpoint (Admin SDK) — no client access. ---
    match /team_snapshots/{teamId}/history/{snapshotId} {
      allow read, write: if false;
    }

    // --- Org stats: the incrementally-maintained "current district totals"
    //     rollup that orgDashboard now reads instead of scanning `cleanups`
    //     live on every pageview (2026-09-01 cost fix — see LEDGER_INBOX.md).
    //     Written only by applyOrgDeltaFor (per-cleanup-write delta),
    //     createSponsorTeam (initial backfill), and buildOrgSnapshots
    //     (weekly self-heal) — all Admin SDK, bypasses these rules. Never
    //     read directly by a client; the orgDashboard HTTPS endpoint (also
    //     Admin SDK) is the only reader. ---
    match /org_stats/{teamId} {
      allow read, write: if false;
    }

    // --- Team stats: the privacy-safe leaderboard aggregate. Written only by
    //     the onCleanupWrite / rebuildTeamStats Cloud Functions (the admin SDK
    //     bypasses these rules); any signed-in user may read. No raw cleanup
    //     routes are ever exposed here. ---
    match /team_stats/{teamId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // --- Team stats counter subcollections: per-member and per-day refcounts
    //     backing team_stats' incremental member_count/total_days fields
    //     (2026-09-01 cost fix — see LEDGER_INBOX.md). Internal bookkeeping
    //     only, never read or written by a client — same admin-only pattern
    //     as team_stats itself. ---
    match /team_stats/{teamId}/members/{uid} {
      allow read, write: if false;
    }
    match /team_stats/{teamId}/days/{day} {
      allow read, write: if false;
    }

    // --- Badges: readable by all signed-in (profiles), writable by owner ---
    match /badges/{badgeId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // --- Challenges: shared. Anyone signed-in reads; creator manages;
    //     participants may add themselves ---
    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.created_by);
      allow update: if signedIn() && (
        resource.data.created_by == request.auth.uid
        // Joining, leaving, inviting, declining. `invited` rides alongside
        // `participants` because accepting an invite touches both in one write
        // (added to participants, removed from invited).
        //
        // Known looseness, inherited from the original participants-only rule:
        // this lets a signed-in user add someone OTHER than themselves. Both
        // arrays are non-destructive social lists — an unwanted invite is
        // dismissible and joining on someone's behalf only credits work they
        // actually did — so it's not worth the per-element array diffing that
        // locking it down would need. Revisit if invites get abused.
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participants', 'invited', 'updated_at'])
      );
      allow delete: if signedIn() && resource.data.created_by == request.auth.uid;

      // Published contributions: one doc per participant holding ONLY their
      // totals for this challenge. Raw cleanups stay owner-only (routes can
      // reveal home addresses), so each member tallies their own work and
      // publishes the numbers here; the group total is the sum of these docs.
      // Any signed-in user may read; you may only write your own, and only
      // these fields, so nobody can inflate someone else's contribution.
      match /contrib/{userId} {
        allow read: if signedIn();
        allow delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.uid == userId
          && request.resource.data.keys().hasOnly(
               ['uid', 'display_name', 'pickups', 'bags', 'cleanups', 'updated_at'])
          && request.resource.data.pickups is number
          && request.resource.data.pickups >= 0
          && request.resource.data.pickups < 1000000
          && request.resource.data.bags is number
          && request.resource.data.bags >= 0
          && request.resource.data.cleanups is number
          && request.resource.data.cleanups >= 0;
      }

      // Live event counters: one doc per participant, own-doc writes only.
      // Sums client-side into the real-time team total (watch team bar).
      match /live/{userId} {
        allow read: if signedIn();
        allow write: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['base', 'session', 'updated_at'])
          && (!('session' in request.resource.data) || request.resource.data.session is number)
          && (!('base' in request.resource.data) || request.resource.data.base is number);
      }
    }

    // --- Street segment status: the shared coverage layer.
    //     Anyone signed-in can read and stamp segments cleaned, but only
    //     with a plausible payload (no backdating, no spoofing others) ---
    match /segment_status/{segmentId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.last_user == request.auth.uid
        && request.resource.data.last_cleaned is number
        && request.resource.data.last_cleaned <= request.time.toMillis() + 60000
        && request.resource.data.last_cleaned > request.time.toMillis() - 86400000;
    }

    // --- Park status: shared park-cleaning layer, mirrors segment_status.
    //     Any signed-in user reads and stamps a park cleaned with a plausible,
    //     non-backdated payload keyed to themselves. (Was missing → the
    //     catch-all denied every markParksCleaned write, so parks never
    //     registered as cleaned.) ---
    match /park_status/{parkId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.last_user == request.auth.uid
        && request.resource.data.last_cleaned is number
        && request.resource.data.last_cleaned <= request.time.toMillis() + 60000
        && request.resource.data.last_cleaned > request.time.toMillis() - 86400000;
    }

    // --- User stats: each picker's own leaderboard aggregate, written by the
    //     owner (doc id = uid). Reads are OPT-IN: only profiles that left
    //     themselves visible (hidden == false) are readable, so a hidden user's
    //     display name is never exposed — the owner can always read their own.
    //     (Was missing → updateUserStats writes were denied and the public
    //     top-picker board never filled in for real users.) ---
    match /user_stats/{userId} {
      allow read: if resource.data.hidden == false || isOwner(userId);
      allow write: if isOwner(userId);
    }

    // --- Analytics: write-only from clients ---
    match /analytics/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // --- Content reports (App Store Guideline 1.2 — UGC apps need a report
    //     mechanism): write-only from clients, same shape as analytics. Only
    //     reviewed via the Firebase console / admin tooling, never read back
    //     by the app — a reporter shouldn't be able to see report contents,
    //     including their own, since that could reveal moderation outcomes. ---
    match /reports/{docId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // --- Public stats: the aggregate dashboard (city + global). PUBLIC read
    //     (no auth) so a public website can show them. Written ONLY by the
    //     scheduledPublicStats / rebuildPublicStats Cloud Functions (admin SDK
    //     bypasses rules). Contents are aggregates only — counts, totals, a
    //     coarse ~1km "recently cleaned" tile grid, and an opt-in top-picker
    //     board (display names of users who left themselves leaderboard-visible).
    //     No routes, no exact locations, no private data. ---
    match /global_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /city_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // --- City requests: "prioritize my city" tally from the map's fallback-
    //     city card. Same shape as city_stats — a public-read aggregate,
    //     written only by the requestCity callable (Admin SDK, bypasses these
    //     rules). The requesters marker subcollection (dedup per uid) is not
    //     client-readable or writable either — the callable is the only path
    //     in, and these rules exist purely to block direct client tampering. ---
    match /city_requests/{slug} {
      allow read: if true;
      allow write: if false;

      match /requesters/{uid} {
        allow read, write: if false;
      }
    }

    // --- Overpass pre-cache (OVERPASS_PRECACHE_SPEC.md): server-fetched
    //     street geometry / admin boundary polygons for popular areas.
    //     PUBLIC read (no auth) — the client's live-Overpass fallback this
    //     replaces isn't auth-gated either, and the contents are the same
    //     public-domain OSM geometry the app already fetches directly.
    //     Written ONLY by the scheduledOverpassPrecacheRefresh /
    //     runOverpassPrecacheRefresh Cloud Functions (Admin SDK, bypasses
    //     these rules). ---
    match /precache_streets/{gridKey} {
      allow read: if true;
      allow write: if false;
    }
    match /precache_boundaries/{cellKey} {
      allow read: if true;
      allow write: if false;
    }

    // --- Adopt-a-street: each picker's adopted spots, private to the owner.
    //     The scheduled Cloud Function (admin SDK) reads them all and stamps
    //     lastNotified; clients only touch their own. ---
    match /adoptions/{adoptionId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
    }

    // --- Mail: outbound email queue for the "Trigger Email" extension. Written
    //     ONLY by Cloud Functions (admin SDK); no client access. ---
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // --- Community posts: the shared photo feed. Any signed-in user can read;
    //     authors create and delete their own; a like only ever changes the
    //     liked_by array (so you can't rewrite someone else's post). ---
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.uid);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liked_by']);
      allow delete: if isOwner(resource.data.uid);
    }

    // --- Feedback: create-only from clients (read only in the Firebase console). ---
    match /feedback/{feedbackId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // --- Public profiles: name, neighborhood, and handle for discovery. Any
    //     signed-in user can read (that's what lets people find and follow each
    //     other); only the owner writes their own. Deliberately holds NO email
    //     — email lookup goes through the hashed email_index below. ---
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);
    }

    // --- Handle claims: handles/{handleLower} = { uid }. Enforces unique
    //     handles. Readable so the app can tell a handle is taken; a claim can
    //     only be written/cleared by the user who owns it (uid == caller), and
    //     an existing claim can't be stolen (checked in the create branch). ---
    match /handles/{handleLower} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      // Re-affirming your own claim is fine; taking someone else's is not.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // --- Email index: email_index/{encodedEmail} = { uid }. Lets someone who
    //     ALREADY knows your email find you. `get` is allowed (you must know
    //     the exact email to form the doc id) but `list` is denied, so nobody
    //     can enumerate the collection to harvest addresses. A user may only
    //     write the entry that points at themselves. ---
    match /email_index/{emailId} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // --- Live walks: "who's cleaning now" presence, one doc per active walker
    //     at live_walks/{uid}. Any signed-in user reads (the live count); you may
    //     only write your OWN doc, and lastPing must be a fresh, non-backdated
    //     timestamp so presence can't be spoofed or held open. No coordinates are
    //     stored — neighborhood name only. ---
    match /live_walks/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId)
        && (request.method == 'delete' || (
             request.resource.data.userId == userId
             && request.resource.data.lastPing is number
             && request.resource.data.lastPing <= request.time.toMillis() + 60000
             && request.resource.data.lastPing > request.time.toMillis() - 300000));
    }

    // --- Follows: one-way follow graph. doc id = "{follower}_{following}".
    //     Anyone signed-in may read (feeds, counts, follow-state); you may only
    //     create edges where YOU are the follower, and only when neither side
    //     has blocked the other (checked both directions against /blocks). ---
    match /follows/{edgeId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.followerId)
        && request.resource.data.followerId != request.resource.data.followingId
        && edgeId == request.resource.data.followerId + '_' + request.resource.data.followingId
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.followerId + '_' + request.resource.data.followingId))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.followingId + '_' + request.resource.data.followerId));
      // Normally only the follower side can delete an edge — but a block
      // should sever an existing relationship immediately, not just block
      // new ones, so also let the BLOCKER remove an edge where the blocked
      // party follows THEM (the one direction the follower-only rule above
      // would otherwise leave them unable to touch).
      allow delete: if isOwner(resource.data.followerId)
        || (isOwner(resource.data.followingId)
            && exists(/databases/$(database)/documents/blocks/$(resource.data.followingId + '_' + resource.data.followerId)));
      allow update: if false;
    }

    // --- Blocks: one user blocking another. doc id = "{blockerUid}_{blockedUid}".
    //     Deliberately allow read: if false — a blocked user should never be
    //     able to tell they've been blocked, only feel its effects (posts
    //     disappearing, follows severed). exists()/get() calls from WITHIN
    //     other rules (see /follows above) bypass this read restriction,
    //     which is exactly what makes the block enforceable without being
    //     visible. A Cloud Function mirrors each block onto the blocked
    //     user's own users/{uid}.blocked_by array (admin SDK, bypasses these
    //     rules) so their client can filter the blocker out of their own
    //     feed using a doc they already read for their own settings. ---
    match /blocks/{blockId} {
      allow create: if isOwner(request.resource.data.blockerUid)
        && request.resource.data.blockerUid != request.resource.data.blockedUid
        && blockId == request.resource.data.blockerUid + '_' + request.resource.data.blockedUid;
      allow delete: if isOwner(resource.data.blockerUid);
      allow read: if false;
    }

    // Everything else: denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
